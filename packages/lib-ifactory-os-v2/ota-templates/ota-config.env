# OTA Template Configuration
# Override these values in your project's ota-config.env file

# Health check settings
HEALTH_CHECK_INTERVAL=2s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_TIMEOUT=30s
HEALTH_CHECK_URL=http://localhost:3000/health

# System requirements
MIN_DISK_SPACE_MB=500
MIN_NODE_VERSION=16.0.0

# Runtime compatibility
RS_RUNTIME_MIN_VERSION=1.0.0
TARGET_PLATFORMS='["ioware-pro-x100", "ioware-gateway"]'
OS_REQUIREMENTS='["linux"]'

# Default values (usually read from package.json)
DEFAULT_AUTHOR="Team Robotspace"
DEFAULT_LICENSE=ISC
